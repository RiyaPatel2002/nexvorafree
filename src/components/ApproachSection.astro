---
const steps = [
	{ title: "Discovery & Consultation", number: "01", tone: "text-cyan-400" },
	{ title: "Business Research", number: "02", tone: "text-blue-500" },
	{ title: "Strategy Planning", number: "03", tone: "text-violet-400" },
	{
		title: "Creative & Technology Execution",
		number: "04",
		tone: "text-amber-400",
	},
	{ title: "Launch & Optimization", number: "05", tone: "text-emerald-400" },
	{ title: "Long-Term Growth Support", number: "06", tone: "text-pink-500" },
] as const;
---

<section data-reveal class="bg-[#0c1220] py-10 text-white lg:py-14">
	<h2
		class="font-canva whitespace-pre-wrap break-normal leading-normal text-white caret-white text-[2rem] font-bold text-center"
	>
		Our Approach
	</h2>
	<div
		class="mx-auto flex max-w-7xl items-center justify-between px-4 py-5 lg:px-8 lg:py-5"
	>
		<div class="mt-10 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
			{
				steps.map((step) => (
					<article class="group flex items-center justify-between rounded-[14px] border border-white/8 [#0D101D] px-8 py-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] transition duration-200 hover:border-white/12 hover:bg-[#1a1d2f]">
						<h3
							class={`text-[17px] font-semibold leading-[1.1] ${step.tone}`}
						>
							{step.title}
						</h3>

						<span class="ml-6 text-[50px] font-bold leading-none tracking-[-0.06em] text-white/6">
							{step.number}
						</span>
					</article>
				))
			}
		</div>
	</div>
</section>

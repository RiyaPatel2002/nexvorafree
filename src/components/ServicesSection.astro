			"Corporate Websites · Landing Pages · E-commerce · Custom Platforms",
		tone: "text-blue-400",
		icon: "globe",
	},
	{
		slug: "ai-solutions",
		title: "AI Solutions",
		description:
			"AI Chatbots · CRM Automation · WhatsApp Automation · AI Workflows",
		tone: "text-violet-400",
		icon: "chip",
	},
	{
		slug: "branding",

		icon: "camera",
	},
	{
		slug: "software-development",
		title: "Software Development",
		description: "CRM · ERP · Business Software · Dashboards",
		tone: "text-emerald-400",
		icon: "code",
	},
	{
		slug: "government-digital-solutions",
		title: "Government Digital Solutions",
		description:
			"Digital Awareness Campaigns · Communication Strategy · Vendor Outreach Support",
		tone: "text-orange-400",
		icon: "government",
	},
	{
		slug: "business-consulting",
		title: "Business Consulting",
		description:
			"Growth Strategy · Digital Transformation · Sales Funnel Planning",
		tone: "text-teal-400",
		icon: "growth",
	},

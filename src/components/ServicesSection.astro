---

<section
	id="services"
	data-reveal
	class="scroll-mt-24 bg-[#0c1220] py-0 text-white lg:py-0"
>
	<h2
		class="font-canva whitespace-pre-wrap break-normal leading-normal text-white caret-white text-[2rem] font-bold text-center"
	>
		Our Services
	</h2>
	<div
		class="mx-auto flex max-w-7xl items-center justify-between px-4 py-5 lg:px-8 lg:py-5"
	>
		<div class="mt-10 grid gap-8 sm:grid-cols-2 xl:grid-cols-4">
			{
				services.map((service) => (
					<article
						id={service.slug}
						class="scroll-mt-24 rounded-[18px] border border-white/8 bg-[#151725] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] transition duration-200 hover:-translate-y-1 hover:border-white/12 hover:bg-[#1a1d2f]"
					>
						<div
							class={` ${service.tone}`}
						>
							<div
								class="h-8 w-8"
								set:html={iconMap[service.icon]}
							/>
						</div>

						<h3 class="mt-5 text-[20px] font-bold leading-[1.1] text-white">
							{service.title}
						</h3>

						<p class="mt-4 max-w-[24ch] text-[16px] leading-[1.30] text-slate-300/75">
							{service.description}
						</p>
					</article>
				))
			}
		</div>
	</div>
</section>

---
const industries = [
	"Government",
	"Manufacturing",
	"Healthcare",
	"Education",
	"Finance",
	"Construction",
	"Hospitality",
	"Technology",
	"Retail",
	"Automobile",
	"Real Estate",
	"Startups",
	"Professional Services",
] as const;
---

<section class="bg-[#050816] py-10 text-white lg:py-0">
	<div class="mx-auto max-w-[760px] text-center">
		<h2
			class="font-canva whitespace-pre-wrap break-normal leading-normal text-white caret-white text-[2rem] font-bold text-center"
		>
			Industries We Serve
		</h2>
		<!-- <p
			class="mt-6 text-[clamp(1.05rem,1.15vw,1.35rem)] leading-[1.3] text-slate-300/85"
		>
			We&apos;re ready to help businesses across
		</p> -->
	</div>
	<div
		class="mx-auto flex max-w-7xl items-center justify-between px-4 py-5 lg:px-8 lg:py-5"
	>
		<div class="mt-10 flex flex-wrap justify-center gap-3">
			{
				industries.map((industry) => (
					<span class="inline-flex items-center rounded-full border border-white/8 bg-[#0D101D] px-5 py-2 text-[16px] font-medium text-slate-200/90 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)] transition duration-200 hover:border-white/12 hover:bg-[#1a1d2f]">
						{industry}
					</span>
				))
			}
		</div>
	</div>
</section>

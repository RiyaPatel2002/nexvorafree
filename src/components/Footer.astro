---
const serviceLinks = [
	{ label: "Performance Marketing", href: "#performance-marketing" },
	{ label: "Website Development", href: "#website-development" },
	{ label: "AI Solutions", href: "#ai-solutions" },
	{ label: "Branding", href: "#branding" },
] as const;

const solutionLinks = [
	{ label: "Creative Studio", href: "#creative-studio" },
	{ label: "Software Development", href: "#software-development" },
	{ label: "Government Solutions", href: "#government-digital-solutions" },
	{ label: "Business Consulting", href: "#business-consulting" },
] as const;
---

<footer data-reveal class="border-t border-white/8 bg-[#0c1220] text-white">
	<div class="mx-auto max-w-7xl px-4 py-16 lg:px-8 lg:py-14">
		<div class="grid gap-12 md:grid-cols-2 xl:grid-cols-4 lg:gap-10">
			<div>
				<h2 class="font-canva text-[1.45rem] font-black uppercase tracking-[-0.05em] text-white">
					NEXVORA
				</h2>
				<p class="mt-4 text-[16px] leading-[1.25] text-slate-300/65">
					A modern, AI-first business growth company helping organizations embrace the next
					generation of digital transformation.
				</p>
			</div>

			<nav aria-label="Services">
				<h3 class="text-[18px] font-bold text-white">
					<a class="transition duration-200 hover:text-cyan-300" href="#services">Services</a>
				</h3>
				<ul class="mt-4 space-y-2 text-[16px] leading-[1.15] text-slate-300/65">
					{
						serviceLinks.map((link) => (
							<li>
								<a class="transition duration-200 hover:text-white" href={link.href}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-label="Solutions">
				<h3 class="text-[18px] font-bold text-white">
					<a class="transition duration-200 hover:text-cyan-300" href="#services">Solutions</a>
				</h3>
				<ul class="mt-4 space-y-2 text-[16px] leading-[1.15] text-slate-300/65">
					{
						solutionLinks.map((link) => (
							<li>
								<a class="transition duration-200 hover:text-white" href={link.href}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div>
				<h3 class="text-[18px] font-bold text-white">Connect</h3>
				<ul class="mt-4 space-y-2 text-[16px] leading-[1.15] text-slate-300/65">
					<li>
						<a class="transition duration-200 hover:text-white" href="mailto:hello@nexvora.com">
							hello@nexvora.com
						</a>
					</li>
					<li>
						<a
							class="transition duration-200 hover:text-white"
							href="https://www.linkedin.com"
							target="_blank"
							rel="noreferrer"
						>
							LinkedIn
						</a>
					</li>
					<li>
						<a
							class="transition duration-200 hover:text-white"
							href="https://www.instagram.com"
							target="_blank"
							rel="noreferrer"
						>
							Instagram
						</a>
					</li>
					<li>
						<a class="transition duration-200 hover:text-white" href="https://x.com" target="_blank" rel="noreferrer">
							X (Twitter)
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-10 border-t border-white/8 pt-8 text-center text-[1.05rem] text-slate-300/45">
			&copy; 2025 NEXVORA. All rights reserved.
		</div>
	</div>
</footer>

---
const reasons = [
	"Personalized Strategy",
	"Transparent Communication",
	"AI-Driven Solutions",
	"Creative Thinking",
	"Business-Focused Approach",
	"Dedicated Project Management",
	"Quality First",
	"Long-Term Partnership",
	"Scalable Solutions",
] as const;
---

<section class="bg-[#050816] py-0 text-white lg:py-10 px-3">
	<h2
		class="font-canva whitespace-pre-wrap break-normal leading-normal text-white caret-white text-[2rem] font-bold text-center"
	>
		Why Choose NEXVORA
	</h2>
	<div
		class="mx-auto flex max-w-7xl items-center justify-between px-4 py-5 lg:px-8 lg:py-5"
	>
		<div class="mt-10 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
			{
				reasons.map((reason) => (
					<article class="flex items-center gap-5 rounded-[14px] border border-white/8 bg-[#0D101D] px-8 py-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] transition duration-200 hover:border-white/12 hover:bg-[#1a1d2f]">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.3"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-7 w-7 shrink-0 text-cyan-400 drop-shadow-[0_0_8px_rgba(34,211,238,0.18)]"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="8.5" />
							<path d="m8.5 12.25 2.65 2.65 4.95-5.9" />
						</svg>

						<p class="text-[clamp(1.05rem,1.15vw,1.45rem)] font-medium leading-[1.2] text-slate-200/90">
							{reason}
						</p>
					</article>
				))
			}
		</div>
	</div>
</section>
